{
 "name": "main_user_isolation",
 "files": {
  "config.json": {
   "version": 1,
   "main_database": "analytics",
   "main_user": "rawbbit_mcp",
   "admin": {
    "host": "127.0.0.1",
    "port": 38123,
    "username": "admin",
    "password": "adminpw",
    "timeout_seconds": 15
   },
   "datasets": [
    {
     "id": "team_a",
     "enabled": true,
     "mode": "managed",
     "endpoint_path": "/datasets/team_a/mcp",
     "database": "team_a",
     "table": "events",
     "create_table": true,
     "main_exposed": false,
     "mcp_user": "rawbbit_mcp_team_a",
     "mcp_role": "rawbbit_role_team_a",
     "mcp_password": "pw-team_a",
     "password_revision": 1,
     "limits": {
      "max_query_rows": 500,
      "max_sample_rows": 50,
      "max_execution_seconds": 30
     }
    }
   ]
  },
  "runtime.json": {
   "version": 1,
   "datasets": [
    {
     "id": "team_a",
     "enabled": true,
     "endpoint_path": "/datasets/team_a/mcp",
     "database": "team_a",
     "table": "events",
     "main_exposed": false,
     "clickhouse_user": "rawbbit_mcp_team_a",
     "clickhouse_password": "pw-team_a",
     "bearer_tokens": {
      "agent": "tok-team_a"
     },
     "max_query_rows": 500,
     "max_sample_rows": 50,
     "max_execution_seconds": 30
    }
   ]
  },
  "schema.sql": "@canonical"
 },
 "steps": [
  {
   "args": [
    "--config",
    "@dir/config.json",
    "--runtime-config",
    "@dir/runtime.json",
    "--schema",
    "@dir/schema.sql",
    "--journal",
    "@dir/journal.json",
    "--preflight-only"
   ]
  },
  {
   "args": [
    "--config",
    "@dir/config.json",
    "--runtime-config",
    "@dir/runtime.json",
    "--schema",
    "@dir/schema.sql",
    "--journal",
    "@dir/journal.json",
    "--preflight-only"
   ],
   "before": [
    "GRANT SELECT ON *.* TO rawbbit_mcp"
   ]
  },
  {
   "args": [
    "--config",
    "@dir/config.json",
    "--runtime-config",
    "@dir/runtime.json",
    "--schema",
    "@dir/schema.sql",
    "--journal",
    "@dir/journal.json",
    "--preflight-only"
   ],
   "before": [
    "REVOKE SELECT ON *.* FROM rawbbit_mcp",
    "CREATE ROLE rawbbit_main_reader",
    "CREATE ROLE rawbbit_nested_reader",
    "GRANT SELECT ON team_a.* TO rawbbit_nested_reader",
    "GRANT rawbbit_nested_reader TO rawbbit_main_reader",
    "GRANT rawbbit_main_reader TO rawbbit_mcp"
   ]
  },
  {
   "args": [
    "--config",
    "@dir/config.json",
    "--runtime-config",
    "@dir/runtime.json",
    "--schema",
    "@dir/schema.sql",
    "--journal",
    "@dir/journal.json",
    "--preflight-only"
   ],
   "before": [
    "REVOKE SELECT ON team_a.* FROM rawbbit_nested_reader",
    "GRANT ALL ON team_a.* TO rawbbit_nested_reader"
   ]
  },
  {
   "args": [
    "--config",
    "@dir/config.json",
    "--runtime-config",
    "@dir/runtime.json",
    "--schema",
    "@dir/schema.sql",
    "--journal",
    "@dir/journal.json",
    "--preflight-only"
   ],
   "before": [
    "REVOKE ALL ON team_a.* FROM rawbbit_nested_reader",
    "DROP USER rawbbit_mcp"
   ]
  }
 ]
}