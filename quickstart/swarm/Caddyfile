# TLS_MODE (set in .env, see README "Behind Cloudflare") picks one of these
# snippets for every site:
#   auto        Caddy obtains certificates itself (ports 80 and 443).
#   cloudflare  Cloudflare proxies the traffic; Caddy serves the Cloudflare
#               Origin Certificate and refuses connections that do not come
#               from Cloudflare.
{
	# The cloudflare snippet refuses non-Cloudflare peers before any handler.
	order abort first

	servers {
		# Only these peers may set the client address (CF-Connecting-IP).
		# deploy.sh sets Cloudflare's ranges in cloudflare mode and
		# 127.0.0.1/32 (nobody, in practice) otherwise.
		trusted_proxies static {$CADDY_TRUSTED_PROXIES}
		client_ip_headers CF-Connecting-IP
	}
}

(tls-auto) {
}

(tls-cloudflare) {
	tls /run/secrets/origin_cert /run/secrets/origin_key
	@not_cloudflare not remote_ip {$CADDY_TRUSTED_PROXIES}
	abort @not_cloudflare
}

# Collector: the game SDKs post event batches here. Caddy terminates TLS,
# answers CORS preflights, enforces the request size limit (413) and passes
# the client address to Vector in X-Forwarded-For (replacing whatever the
# client sent). Vector checks the API key.
{$COLLECTOR_PUBLIC_HOSTNAME} {
	import tls-{$TLS_MODE}

	request_body {
		max_size {$MAX_REQUEST_BYTES}
	}

	# Origins allowed to call the collector from a browser. deploy.sh builds
	# CORS_ORIGIN_REGEX from the comma-separated CORS_ALLOW_ORIGINS ("*" allows
	# every origin; empty allows none).
	@cors header_regexp Origin {$CORS_ORIGIN_REGEX}
	@preflight {
		method OPTIONS
		header_regexp Origin {$CORS_ORIGIN_REGEX}
	}

	handle /healthz {
		rewrite * /health
		reverse_proxy vector:8686
	}

	handle @preflight {
		header {
			Access-Control-Allow-Origin "{http.request.header.Origin}"
			Access-Control-Allow-Methods "POST, OPTIONS"
			Access-Control-Allow-Headers "{http.request.header.Access-Control-Request-Headers}"
			Access-Control-Max-Age "{$CORS_MAX_AGE_SECONDS}"
			Vary Origin
		}
		respond 204
	}

	handle /v1/events:batch {
		header @cors {
			Access-Control-Allow-Origin "{http.request.header.Origin}"
			Access-Control-Expose-Headers "Retry-After"
			Vary Origin
		}
		reverse_proxy vector:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		respond `{"detail":"Not Found"}` 404
	}
}

{$MCP_PUBLIC_HOSTNAME} {
	import tls-{$TLS_MODE}

	encode zstd gzip

	reverse_proxy mcp-server:8000
}

{$METABASE_PUBLIC_HOSTNAME} {
	import tls-{$TLS_MODE}

	encode zstd gzip

	reverse_proxy metabase:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# ClickHouse is reachable only inside the overlay network. To expose it for
# IDE access, add a block such as:
#
# clickhouse.example.com {
# 	encode zstd gzip
# 	reverse_proxy clickhouse:8123
# }
