# Rawbbit Docker Swarm environment.
#
# Copy to `.env` on the manager you deploy from, replace every `change_me`
# value and run ./deploy.sh. Do not commit `.env`.

# Stack name used by `docker stack deploy`.
RAWBBIT_STACK_NAME=rawbbit

# Host directory on the data node that holds all persistent state.
RAWBBIT_DATA_ROOT=/srv/rawbbit

# ---------------------------------------------------------------- images
# Swarm cannot build images. The MCP server is the only Rawbbit image; CI
# publishes it for linux/amd64 and linux/arm64 on every release tag.
MCP_SERVER_IMAGE=ghcr.io/change_me/rawbbit-mcp-server:latest
# VECTOR_IMAGE=timberio/vector:0.62.0-alpine
# CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:24.8

# --------------------------------------------------------------- scaling
# Stateless services. Stateful ones always run one replica on the data node.
VECTOR_REPLICAS=1
# 0 = no limit; 1 = at most one Vector replica per node.
VECTOR_MAX_REPLICAS_PER_NODE=0
MCP_SERVER_REPLICAS=1
METABASE_REPLICAS=1

# ------------------------------------------------------- public hostnames
COLLECTOR_PUBLIC_HOSTNAME=collector.example.com
MCP_PUBLIC_HOSTNAME=mcp.example.com
METABASE_PUBLIC_HOSTNAME=metabase.example.com

# --------------------------------------------------------------------- TLS
# auto: Caddy obtains certificates itself (needs ports 80 and 443).
# cloudflare-flexible: Cloudflare proxies the hostnames (orange cloud, SSL
# "Flexible") and talks plain HTTP to Caddy on HTTP_PORT.
# cloudflare: Cloudflare proxies the hostnames (SSL "Full (strict)") and
# Caddy serves the Cloudflare Origin Certificate on HTTPS_PORT.
# In both cloudflare modes only Cloudflare may connect. See README "Behind
# Cloudflare".
TLS_MODE=auto
HTTP_PORT=80
HTTPS_PORT=443
# ORIGIN_CERT_FILE=cloudflare/origin.pem
# ORIGIN_KEY_FILE=cloudflare/origin.key

LOG_LEVEL=INFO

# ------------------------------------------------------ event collector
# Each API key may send events for exactly one app_id.
COLLECTOR_API_KEYS_JSON={"change_me_api_key":"com.example.app"}
IP_HASH_SALT=change_me
# Caddy answers 413 above this size; the SDKs then split the batch.
MAX_REQUEST_BYTES=1048576

# Browser games: comma-separated origins allowed to post events, for example
# https://game.example.com,http://localhost:5173. "*" allows any origin;
# empty allows none (native and Unity games do not need CORS).
CORS_ALLOW_ORIGINS=
CORS_MAX_AGE_SECONDS=600

# GeoIP: with 1, Vector adds country and country_code from
# GEOIP_HOST_DIR/dbip-country-lite.mmdb, which must exist on every node that
# can run a Vector replica. The directory must exist even with GeoIP off.
GEOIP_ENABLED=0
GEOIP_HOST_DIR=/srv/rawbbit-geoip

# Optional datasets: send some app_ids to their own database and MCP
# endpoint. Copy datasets.example.json to datasets.json (see README).
# RAWBBIT_DATASETS_FILE=datasets.json

# ------------------------------------------------------------ ClickHouse
CLICKHOUSE_ADMIN_USER=admin
CLICKHOUSE_ADMIN_PASSWORD=change_me_clickhouse_admin_password
# Profiles in ./clickhouse. For 8 vCPU / 32 GB use production-small.xml +
# production-small-users.xml; for 8 vCPU / 64 GB use production-medium.xml +
# production-medium-users.xml.
CLICKHOUSE_CONFIG_PROFILE_FILE=low-memory.xml
CLICKHOUSE_USERS_PROFILE_FILE=low-memory-users.xml

# Vector inserts as rawbbit_vector with this password.
CLICKHOUSE_VECTOR_PASSWORD=change_me_clickhouse_vector_password
CLICKHOUSE_MCP_USER=rawbbit_mcp
CLICKHOUSE_MCP_PASSWORD=change_me_clickhouse_mcp_password
CLICKHOUSE_METABASE_USER=metabase_reader
CLICKHOUSE_METABASE_PASSWORD=change_me_clickhouse_metabase_password

# --------------------------------------------------------------- backups
# Daily BACKUP of analytics and every dataset database, at BACKUP_AT (UTC),
# into ${RAWBBIT_DATA_ROOT}/clickhouse/backups; the newest BACKUP_KEEP_LOCAL
# copies are kept.
BACKUP_AT=03:30
BACKUP_KEEP_LOCAL=7
# Optional off-site copy of every backup, for example
# https://my-bucket.s3.us-east-1.amazonaws.com/rawbbit (expire old copies
# with a bucket lifecycle rule).
BACKUP_S3_URL=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# ------------------------------------------------------------ MCP server
MCP_PATH=/mcp
MCP_MAX_QUERY_ROWS=500
MCP_MAX_SAMPLE_ROWS=50
MCP_MAX_EXECUTION_SECONDS=30
MCP_BOT_USER_AGENT_REGEX='bot|spider|crawler|headless|bytespider|ahrefs|googlebot'
# Public MCP deployments must use auth, for example:
# MCP_API_KEYS_JSON='{"alice":"long-random-token"}'
MCP_API_KEYS_JSON=
MCP_ALLOW_UNAUTHENTICATED=0
MCP_JWT_PUBLIC_KEY=
MCP_JWT_JWKS_URI=
MCP_JWT_ISSUER=
MCP_JWT_AUDIENCE=

# ------------------------------------------------- Postgres + Metabase
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change_me_postgres_superuser_password
METABASE_DB_NAME=metabase
METABASE_DB_USER=metabase_app
METABASE_DB_PASSWORD=change_me_metabase_db_password
METABASE_TIMEZONE=UTC
