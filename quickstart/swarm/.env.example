# Rawbbit Docker Swarm environment.
#
# Copy to `.env` on the manager you deploy from, replace every `change_me`
# value and run ./deploy.sh. Do not commit `.env`.

# Stack name used by `docker stack deploy`.
RAWBBIT_STACK_NAME=rawbbit

# Host directory on the data node that holds all persistent state.
RAWBBIT_DATA_ROOT=/srv/rawbbit

# ---------------------------------------------------------------- images
# Swarm cannot build images. Push multi-arch (linux/amd64,linux/arm64) Go
# images to a registry every node can pull from. The previously published
# ghcr.io/mirlan-irokez/rawbbit-* tags are Python and linux/amd64 only.
COLLECTOR_API_IMAGE=registry.example.com/rawbbit-collector-api:change_me
RAW_WRITER_IMAGE=registry.example.com/rawbbit-raw-writer:change_me
MCP_SERVER_IMAGE=registry.example.com/rawbbit-mcp-server:change_me
DBT_RUNNER_IMAGE=registry.example.com/rawbbit-dbt-runner:change_me

# --------------------------------------------------------------- scaling
# Stateless services. Stateful ones always run one replica on the data node.
COLLECTOR_API_REPLICAS=2
# 0 = no limit; 1 = at most one collector per node.
COLLECTOR_API_MAX_REPLICAS_PER_NODE=0
RAW_WRITER_REPLICAS=1
MCP_SERVER_REPLICAS=1
METABASE_REPLICAS=1

# ------------------------------------------------------- public hostnames
COLLECTOR_PUBLIC_HOSTNAME=collector.example.com
MCP_PUBLIC_HOSTNAME=mcp.example.com
METABASE_PUBLIC_HOSTNAME=metabase.example.com

LOG_LEVEL=INFO
RAWBBIT_ENV=production

# ----------------------------------------------------------- NATS stream
NATS_STREAM=EVENTS
NATS_SUBJECT_PREFIX=events
# 24h retention; 7 days = 604800.
NATS_STREAM_MAX_AGE_SECONDS=86400
NATS_DUPLICATE_WINDOW_SECONDS=600

# ---------------------------------------------------------- collector API
NATS_MAX_INFLIGHT_PUBLISHES=512
MAX_EVENTS_PER_REQUEST=500
MAX_REQUEST_BYTES=1048576
COLLECTOR_API_KEYS_JSON={"change_me_api_key":"com.example.app"}
IP_HASH_SALT=change_me
STORE_RAW_IP=0

# GeoIP: the .mmdb file must exist at GEOIP_HOST_DIR on every node that can
# run a collector replica. The directory must exist even with GeoIP disabled.
GEOIP_ENABLED=0
GEOIP_HOST_DIR=/srv/rawbbit-geoip
GEOIP_MMDB_PATH=/var/lib/geoip/dbip-country-lite.mmdb

CORS_ALLOW_ORIGINS=
CORS_ALLOW_METHODS=POST,OPTIONS
CORS_ALLOW_HEADERS=*
CORS_ALLOW_CREDENTIALS=0
CORS_MAX_AGE_SECONDS=600

# ------------------------------------------------------------ raw writer
NATS_CONSUMER=raw-writer
NATS_FETCH_BATCH=200
NATS_FETCH_TIMEOUT_SECONDS=1
NATS_ACK_WAIT_SECONDS=300
NATS_MAX_DELIVER=10
NATS_MAX_ACK_PENDING=10000
RAW_FLUSH_INTERVAL_SECONDS=60
RAW_MAX_EVENTS_PER_FILE=10000
RAW_MAX_BYTES_PER_FILE=52428800
# With N raw-writer replicas, set about 0.8 * NATS_MAX_ACK_PENDING / N.
RAW_MAX_BUFFERED_EVENTS=

# ------------------------------------------------- SeaweedFS (local S3)
# deploy.sh generates the SeaweedFS identities file from these three
# credentials. Use letters, digits and + / = _ - only.
S3_BUCKET=rawbbit-raw
S3_PREFIX=raw
S3_WRITER_ACCESS_KEY=change_me_writer_access_key
S3_WRITER_SECRET_KEY=change_me_writer_secret_key
S3_READER_ACCESS_KEY=change_me_reader_access_key
S3_READER_SECRET_KEY=change_me_reader_secret_key
S3_ADMIN_ACCESS_KEY=change_me_admin_access_key
S3_ADMIN_SECRET_KEY=change_me_admin_secret_key

SEAWEED_VOLUME_SIZE_LIMIT_MB=5000
SEAWEED_VOLUME_MAX=0
SEAWEED_VOLUME_MIN_FREE_SPACE_GB=5

# ------------------------------------------------------------ ClickHouse
CLICKHOUSE_ADMIN_USER=admin
CLICKHOUSE_ADMIN_PASSWORD=change_me_clickhouse_admin_password
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_TABLE=events
# Profiles from ../vm_rawbbit_two/clickhouse. For 8 vCPU / 32 GB use
# production-small.xml + production-small-users.xml; for 8 vCPU / 64 GB use
# production-medium.xml + production-medium-users.xml.
CLICKHOUSE_CONFIG_PROFILE_FILE=low-memory.xml
CLICKHOUSE_USERS_PROFILE_FILE=low-memory-users.xml

CLICKHOUSE_MCP_USER=rawbbit_mcp
CLICKHOUSE_MCP_PASSWORD=change_me_clickhouse_mcp_password
CLICKHOUSE_METABASE_USER=metabase_reader
CLICKHOUSE_METABASE_PASSWORD=change_me_clickhouse_metabase_password
CLICKHOUSE_LOADER_USER=rawbbit_loader
CLICKHOUSE_LOADER_PASSWORD=change_me_clickhouse_loader_password
CLICKHOUSE_DBT_USER=rawbbit_dbt
CLICKHOUSE_DBT_PASSWORD=change_me_clickhouse_dbt_password

# ------------------------------------------------------ ingestion runner
# "dbt" makes the runner load raw Parquet into ClickHouse. The host cron
# shell loader of the two-VM guide is not used in Swarm.
RAWBBIT_RAW_LOAD_MODE=dbt
DBT_CLICKHOUSE_MAX_THREADS=2
RAWBBIT_DBT_HOURLY_LOOKBACK_HOURS=3
RAWBBIT_DBT_DAILY_LOOKBACK_DAYS=3
RAWBBIT_DBT_BACKFILL_CHUNK_HOURS=24
RAWBBIT_DBT_ROUTING_ENABLED=0

# ------------------------------------------------------------ MCP server
MCP_PATH=/mcp
MCP_MAX_QUERY_ROWS=500
MCP_MAX_SAMPLE_ROWS=50
MCP_MAX_EXECUTION_SECONDS=30
MCP_BOT_USER_AGENT_REGEX='bot|spider|crawler|headless|bytespider|ahrefs|googlebot'
# Public MCP deployments must use auth, for example:
# MCP_API_KEYS_JSON='{"alice":"long-random-token"}'
MCP_API_KEYS_JSON=
MCP_ALLOW_UNAUTHENTICATED=0
MCP_JWT_PUBLIC_KEY=
MCP_JWT_JWKS_URI=
MCP_JWT_ISSUER=
MCP_JWT_AUDIENCE=

# ------------------------------------------------- Postgres + Metabase
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change_me_postgres_superuser_password
METABASE_DB_NAME=metabase
METABASE_DB_USER=metabase_app
METABASE_DB_PASSWORD=change_me_metabase_db_password
METABASE_TIMEZONE=UTC

# ------------------------------------------- optional AWS S3 off-site copy
# 1 adds stack.aws-replica.yml: rclone copies new raw objects to AWS.
AWS_REPLICA_ENABLED=0
# AWS bucket names cannot contain underscores.
AWS_REPLICA_BUCKET=change-me-rawbbit-raw-backup
AWS_REPLICA_PREFIX=raw
AWS_REPLICA_REGION=us-east-1
AWS_REPLICA_ACCESS_KEY_ID=change_me
AWS_REPLICA_SECRET_ACCESS_KEY=change_me
AWS_REPLICA_INTERVAL_SECONDS=300
AWS_REPLICA_MAX_AGE=72h
AWS_REPLICA_TRANSFERS=4
# STANDARD by default. STANDARD_IA bills objects under 128 KB as 128 KB and
# for at least 30 days, which hurts with many small hourly files.
AWS_REPLICA_STORAGE_CLASS=STANDARD
# AWS by default. For another S3-compatible service set the endpoint and an
# rclone provider name (Other, Cloudflare, Wasabi, Minio, ...).
AWS_REPLICA_PROVIDER=AWS
AWS_REPLICA_ENDPOINT=
